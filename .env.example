# Copy to .env.local (ignored) for a local build with analytics, or set these
# in Vercel → Settings → Environment Variables. Leave both empty and the site
# loads no analytics at all. See docs/ANALYTICS.md.
VITE_GA4_ID=
VITE_META_PIXEL_ID=

# The public origin, for the canonical link, og:image, the sitemap and
# robots.txt. On Vercel this is read from VERCEL_PROJECT_PRODUCTION_URL when
# unset. See docs/DEPLOY.md.
SITE_URL=

# 1 shows drafted copy, tagged, in a production style build. Vercel previews
# show drafts automatically. See src/content/drafts.ts.
SHOW_DRAFTS=
